# ---- Interval mean Δ′17Owater and confidence bands ----
D17O_interval_summary <- BHB_water_isotope_space %>%
group_by(strat_interval) %>%
summarise(
n = sum(!is.na(D17Orsw_mean_permeg)),
mean_D17O = mean(D17Orsw_mean_permeg, na.rm = TRUE),
sd_D17O = sd(D17Orsw_mean_permeg, na.rm = TRUE),
se_D17O = sd_D17O / sqrt(n),
.groups = "drop"
) %>%
mutate(
# Confidence intervals around the interval mean
lower50 = mean_D17O - qt(0.75,  df = n - 1) * se_D17O,
upper50 = mean_D17O + qt(0.75,  df = n - 1) * se_D17O,
lower80 = mean_D17O - qt(0.90,  df = n - 1) * se_D17O,
upper80 = mean_D17O + qt(0.90,  df = n - 1) * se_D17O,
lower95 = mean_D17O - qt(0.975, df = n - 1) * se_D17O,
upper95 = mean_D17O + qt(0.975, df = n - 1) * se_D17O
)
D17O_interval_summary
source("~/Documents/GitHub/bighorn_paleogene_proxies/scripts/10_other_plots.R", echo=TRUE)
# ---- Temperature versus reconstructed Δ′17O soil water ----
BHB_T_D17Orsw <- BHB_D17Orsw_recon %>%
filter(
!is.na(strat_height_m),
!is.na(T_recon_C),
!is.na(T_recon_se_C),
!is.na(D17Orsw_mean_permeg)
) %>%
mutate(
strat_interval = case_when(
strat_height_m < 1506 ~ "Before PETM",
between(strat_height_m, 1506, 1543) ~ "During PETM",
strat_height_m > 1543 ~ "After PETM"
),
strat_interval = factor(
strat_interval,
levels = c("Before PETM", "During PETM", "After PETM")
)
)
p_T_D17Orsw <- ggplot(
BHB_T_D17Orsw,
aes(
x = T_recon_C,
y = D17Orsw_mean_permeg,
color = strat_interval,
fill = strat_interval
)
) +
# Temperature 95% uncertainty
geom_errorbarh(
aes(
xmin = T_recon_C - 1.96 * T_recon_se_C,
xmax = T_recon_C + 1.96 * T_recon_se_C
),
height = 0,
linewidth = 0.45,
alpha = 0.65
) +
# Reconstructed Δ′17Owater 95% uncertainty
geom_errorbar(
aes(
ymin = D17Orsw_lower95_permeg,
ymax = D17Orsw_upper95_permeg
),
width = 0,
linewidth = 0.45,
alpha = 0.65
) +
geom_point(
shape = 21,
size = 3.2,
stroke = 0.8
) +
scale_color_manual(
values = c(
"Before PETM" = "#2166AC",
"During PETM" = "#B2182B",
"After PETM"  = "#4D9221"
)
) +
scale_fill_manual(
values = c(
"Before PETM" = "#67A9CF",
"During PETM" = "#EF8A62",
"After PETM"  = "#A6D96A"
)
) +
labs(
x = expression("Reconstruction temperature ("*degree*C*")"),
y = expression(Delta*"'"^17*"O"[soil~water]*" (per meg)"),
color = "Stratigraphic interval",
fill = "Stratigraphic interval"
) +
theme_classic(base_size = 11) +
theme(
axis.title = element_text(face = "bold"),
legend.position = "right"
)
p_T_D17Orsw
ggsave(
here(
"figures",
"BHB_temperature_vs_D17Orsw.png"
),
plot = p_T_D17Orsw,
width = 7,
height = 5.5,
dpi = 600
)
