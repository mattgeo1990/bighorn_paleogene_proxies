IPL_clumped_summary$Strat_m_Bowen[which(IPL_clumped_summary$SampleID %in% "PK95-SC-118up")] <- 1325
IPL_clumped_summary$Strat_m_Bowen[which(IPL_clumped_summary$SampleID %in% "PK95-SC-27")] <- 1525.0
