) %>%
config(
displaylogo = FALSE,
modeBarButtonsToRemove = c(
"lasso2d",
"select2d"
)
)
library(plotly)
#-- Interactive T47 versus reconstructed d18Owater -------------------------
CFB_T47_d18Owater_interactive_data <- CFB_d18O_T47_observations %>%
mutate(
sample_type = case_when(
carbonate_type == "Spar" ~ "Spar",
carbonate_type == "Altered carbonate" ~ "Altered",
carbonate_type == "Pedogenic micrite" ~ "Bulk matrix (primary)",
TRUE ~ "Other"
),
sample_type = factor(
sample_type,
levels = c(
"Bulk matrix (primary)",
"Altered",
"Spar",
"Other"
)
),
d18Owater_vsmow = calc_d18Owater_from_carb_KO97(
T47_C,
d18Ocarb_vsmow
),
hover_text = paste0(
"<b>", MLA_horizon_id, "</b>",
"<br>Material: ", sample_type,
"<br>Source: ", source,
"<br>T47: ", round(T47_C, 1), " °C",
if_else(
is.finite(T47_se_C),
paste0(" ± ", round(T47_se_C, 1), " °C SE"),
""
),
"<br>δ18Owater: ",
round(d18Owater_vsmow, 2), "‰ VSMOW",
"<br>δ18Ocarbonate: ",
round(d18Ocarb_vsmow, 2), "‰ VSMOW",
"<br>Alteration likelihood: ",
str_replace_all(alteration_likelihood, "_", " ")
)
) %>%
filter(
is.finite(T47_C),
is.finite(d18Owater_vsmow)
)
interactive_shapes <- c(
"Bulk matrix (primary)" = 21,
"Altered" = 22,
"Spar" = 24,
"Other" = 23
)
interactive_colors <- c(
"no_indication" = "#0072B2",
"possible" = "#F0E442",
"moderate" = "#E69F00",
"high" = "#D55E00",
"not_assessed" = "#999999"
)
p_CFB_T47_d18Owater_interactive_base <- ggplot(
CFB_T47_d18Owater_interactive_data,
aes(
x = T47_C,
y = d18Owater_vsmow,
shape = sample_type,
fill = alteration_likelihood,
text = hover_text
)
) +
geom_errorbarh(
aes(
xmin = T47_C - T47_se_C,
xmax = T47_C + T47_se_C
),
height = 0,
linewidth = 0.35,
alpha = 0.45,
na.rm = TRUE
) +
geom_point(
size = 3.6,
color = "black",
stroke = 0.7,
alpha = 0.9
) +
scale_shape_manual(
values = interactive_shapes,
drop = FALSE
) +
scale_fill_manual(
values = interactive_colors,
labels = c(
no_indication = "No indication",
possible = "Possible",
moderate = "Moderate",
high = "High",
not_assessed = "Not assessed"
),
na.value = "#999999"
) +
labs(
x = expression(Delta[47] * " temperature (" * degree * "C)"),
y = expression(delta^18 * O[water] ~ "(‰ VSMOW)"),
shape = "Sample type",
fill = "Alteration likelihood",
title = expression(
"CFB " * T[47] * " versus reconstructed " *
delta^18 * O[water]
),
subtitle = paste(
"Parent-water values calculated using",
"Kim and O'Neil (1997) calcite-water fractionation"
)
) +
theme_classic(base_size = 16) +
theme(
legend.position = "right",
legend.box = "vertical"
)
p_CFB_T47_d18Owater_interactive <- ggplotly(
p_CFB_T47_d18Owater_interactive_base,
tooltip = "text",
dynamicTicks = TRUE
) %>%
layout(
hovermode = "closest",
legend = list(
orientation = "v",
x = 1.02,
y = 1
),
margin = list(r = 220)
) %>%
config(
displaylogo = FALSE,
modeBarButtonsToRemove = c(
"lasso2d",
"select2d"
)
)
